rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function canSeeContent(uid) {
      let user = get(/databases/$(database)/documents/users/$(uid)).data;
          return !user.isPrivate || isSelf(uid) ||
            (exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)).data.status == 'active');
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Limited "events-only admin" role granted via the contact-us
    // organization flow. Lets these users create / edit / delete events
    // but nothing else (no user moderation, no app config, no reports
    // access). Always rule-or'd alongside isAdmin() at the event match.
    function isOrgAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'org_admin';
    }

    function isChatParticipant(chatId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // Public app-wide config (feature flags, announcements, maintenance).
    // Any signed-in user reads it; only admins write.
    match /adminConfig/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Blacklisted emails. Admins manage the full list; signed-in users may
    // also read and write their own entry so the client can (a) check on
    // login whether their account has been deleted and (b) write a
    // tombstone for themselves during self-delete.
    match /blacklist/{email} {
      allow read: if isAdmin() ||
        (signedIn() && request.auth.token.email == email);
      allow write: if isAdmin() ||
        (signedIn() && request.auth.token.email == email);
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isSelf(uid);
      allow update: if isSelf(uid) || isAdmin();
      allow delete: if isSelf(uid) || isAdmin();

      match /followers/{followerUid} {
        // Any signed-in user can read individual follower docs (needed for
        // the isFollowing check and follower counts on profiles). The data
        // only contains UIDs and timestamps — no sensitive info.
        allow read: if signedIn();
        allow create: if isSelf(followerUid) || isSelf(uid);
        allow delete: if isSelf(followerUid) || isSelf(uid) || isAdmin();
        allow update: if isSelf(uid);
      }

      match /following/{followingUid} {
        // The owner can always read their own following list. Other
        // signed-in users can read it for counts/list display on profiles.
        allow read: if signedIn();
        allow create: if isSelf(uid) || isSelf(followingUid);
        allow delete: if isSelf(uid) || isSelf(followingUid) || isAdmin();
        allow update: if isSelf(uid) || isSelf(followingUid);
      }

      match /blockedUsers/{blockedUid} {
        allow read: if signedIn();
        allow create, delete: if isSelf(uid) || isAdmin();
        allow update: if false;
      }

      match /reposts/{postId} {
        allow read: if signedIn();
        allow create: if isSelf(uid);
        allow delete: if isSelf(uid) || isAdmin();
        allow update: if false;
      }

      match /saved/{postId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid);
        allow delete: if isSelf(uid) || isAdmin();
        allow update: if false;
      }

      match /savedTranslations/{translationId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid);
        allow delete: if isSelf(uid) || isAdmin();
        allow update: if false;
      }

      // "Who viewed my profile" — one doc per visitor at
      // users/{uid}/visitors/{visitorUid}. Only the profile owner (or an
      // admin) can read the list. The visitor writes their own doc on
      // visit; the owner may delete entries to clear their list.
      match /visitors/{visitorUid} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isSelf(visitorUid) && visitorUid != uid;
        allow delete: if isSelf(uid) || isSelf(visitorUid) || isAdmin();
      }
    }

    // Collection-group access for admin cleanup (deleteUser cascade).
    match /{path=**}/followers/{followerUid} {
      allow read: if isAdmin();
    }
    match /{path=**}/following/{followingUid} {
      allow read: if isAdmin();
    }
    match /{path=**}/comments/{commentId} {
      allow read: if isAdmin();
    }
    match /{path=**}/likes/{likeUid} {
      allow read: if isAdmin();
    }
    match /{path=**}/reposts/{repostUid} {
      allow read: if isAdmin();
    }

    match /follows/{targetUid}/followers/{followerUid} {
      allow read: if signedIn();
      allow create, delete: if isSelf(followerUid);
    }

    match /posts/{postId} {
      // Any signed-in user can read posts. Privacy/blocking is enforced on
      // the client (the feed filters posts whose author is private and not
      // followed). The previous `canSeeContent` rule called get() on the
      // author's user doc, which made list queries fail entirely because
      // Firestore can't filter list results by rule — it can only reject
      // the whole query.
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.authorUid == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount', 'likesCount'])
      );
      allow delete: if signedIn() && (
        resource.data.authorUid == request.auth.uid || isAdmin()
      );

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if isSelf(uid);
        allow delete: if isSelf(uid) || isAdmin();
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
        allow delete: if signedIn() && (
          resource.data.authorUid == request.auth.uid || isAdmin()
        );
        allow update: if false;

        match /likes/{uid} {
          allow read: if signedIn();
          allow create: if isSelf(uid);
          allow delete: if isSelf(uid) || isAdmin();
          allow update: if false;
        }
      }

      match /reposts/{uid} {
        allow read: if signedIn();
        allow create: if isSelf(uid);
        allow delete: if isSelf(uid) || isAdmin();
        allow update: if false;
      }
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.authorUid == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount', 'likesCount'])
      );
      allow delete: if signedIn() && (
        resource.data.authorUid == request.auth.uid || isAdmin()
      );

      match /likes/{uid} {
        allow read: if true;
        allow create: if isSelf(uid);
        allow delete: if isSelf(uid) || isAdmin();
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
        allow delete: if signedIn() && (
          resource.data.authorUid == request.auth.uid || isAdmin()
        );
        allow update: if false;

        match /likes/{uid} {
          allow read: if true;
          allow create: if isSelf(uid);
          allow delete: if isSelf(uid) || isAdmin();
          allow update: if false;
        }
      }

      match /viewers/{viewerUid} {
        allow read: if signedIn() && (
          isSelf(viewerUid) ||
          get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid == request.auth.uid ||
          isAdmin()
        );
        allow create: if isSelf(viewerUid);
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /events/{eventId} {
      allow read: if true;
      // Full admins may create / edit / delete any event. Org-admins
      // (organizations approved via the contact-us flow) may create
      // their own and only edit / delete the ones THEY created.
      allow create: if isAdmin() || (
        isOrgAdmin() &&
        request.resource.data.createdByUid == request.auth.uid
      );
      allow update, delete: if isAdmin() || (
        isOrgAdmin() &&
        resource.data.createdByUid == request.auth.uid
      );

      match /attendees/{uid} {
        allow read: if true;
        allow create, delete: if isSelf(uid);
      }
    }

    // ── Event registration requests ─────────────────────────
    // Doc id is deterministic `{eventId}_{uid}` so a user can only have one
    // in-flight request per event and can read their own record.
    match /eventRegistrations/{regId} {
      // `get` must succeed even when the doc doesn't yet exist, so the
      // event-detail screen can render the "Register" button for a
      // user who has never registered for this event. We allow it
      // when the deterministic doc id ends with the user's uid — that
      // guarantees the user is only ever reading their own
      // (potentially missing) record.
      allow get: if signedIn() && (
        isAdmin() ||
        (resource != null &&
          resource.data.userUid == request.auth.uid) ||
        regId.matches('.*_' + request.auth.uid)
      );
      allow list: if isAdmin();
      allow create: if signedIn() &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      // Only admins can approve/reject. Users may not edit a submitted request.
      allow update, delete: if isAdmin();
    }

    // ── Collection-group rule for members ────────────────────
    // Required to allow collectionGroup('members').where('uid', ...) queries
    // used to look up which event chats the current user belongs to.
    // Only the member themselves (or an admin) may read their own member doc
    // via the collection group.
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && (isSelf(uid) || isAdmin());
    }

    // ── Event group chats (members read, admin writes) ──────
    match /eventChats/{eventId} {
      allow read: if signedIn() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/eventChats/$(eventId)/members/$(request.auth.uid))
      );
      // Full admins manage every event chat; org-admins may create or
      // update only the chat for an event they themselves created
      // (write happens inline from AdminService.createEvent right
      // after the parent event doc is written).
      allow create, update: if isAdmin() || (
        isOrgAdmin() &&
        request.resource.data.adminUid == request.auth.uid
      );
      allow delete: if isAdmin();

      match /members/{uid} {
        // Any member of the chat (or admin) can read the members list so
        // they can see who else is in the group.
        allow read: if signedIn() && (
          isSelf(uid) ||
          isAdmin() ||
          exists(/databases/$(database)/documents/eventChats/$(eventId)/members/$(request.auth.uid))
        );
        // Members are added by the admin on approval; users can only remove
        // themselves (leave). Admin may also re-write the member doc when
        // adding a user directly (set with merge:true).
        allow create, update: if isAdmin();
        allow delete: if isSelf(uid) || isAdmin();
      }

      match /messages/{messageId} {
        allow read: if signedIn() && (
          isAdmin() ||
          exists(/databases/$(database)/documents/eventChats/$(eventId)/members/$(request.auth.uid))
        );
        // Only admins may send the message itself. Members may still react
        // on the subcollection below.
        allow create: if isAdmin() &&
          request.resource.data.senderUid == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin();

        match /reactions/{reactorUid} {
          allow read: if signedIn() && (
            isAdmin() ||
            exists(/databases/$(database)/documents/eventChats/$(eventId)/members/$(request.auth.uid))
          );
          allow create, update, delete: if isSelf(reactorUid) && (
            isAdmin() ||
            exists(/databases/$(database)/documents/eventChats/$(eventId)/members/$(request.auth.uid))
          );
        }
      }

      match /polls/{pollId} {
        allow read: if signedIn() && (
          isAdmin() ||
          exists(/databases/$(database)/documents/eventChats/$(eventId)/members/$(request.auth.uid))
        );
        // Only the event admin can create / close / delete polls.
        allow create: if isAdmin()
          && request.resource.data.createdByUid == request.auth.uid;
        allow update, delete: if isAdmin();

        match /votes/{voterUid} {
          allow read: if signedIn() && (
            isAdmin() ||
            exists(/databases/$(database)/documents/eventChats/$(eventId)/members/$(request.auth.uid))
          );
          allow create, update, delete: if isSelf(voterUid) && (
            isAdmin() ||
            exists(/databases/$(database)/documents/eventChats/$(eventId)/members/$(request.auth.uid))
          );
        }
      }
    }

    match /feeds/{uid}/timeline/{postId} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    match /chats/{chatId} {
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/chats/$(chatId)) ||
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow list: if signedIn() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      // Any participant can update the chat doc (send a message bumps
      // lastMessage / unread counts). The group admin can also rename
      // or add/remove members through this same path.
      allow update: if signedIn() && (
        request.auth.uid in resource.data.participants ||
        request.auth.uid in request.resource.data.participants
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId) || isAdmin();
        allow create: if isChatParticipant(chatId) && request.resource.data.senderUid == request.auth.uid;
        // Chat participants may mark messages seen, hide a message for
        // themselves, and the sender may delete a message for everyone.
        allow update: if isChatParticipant(chatId) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy']) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedForUids']) &&
            request.resource.data.deletedForUids is list &&
            request.resource.data.deletedForUids.size() ==
              (resource.data.deletedForUids is list ? resource.data.deletedForUids.size() : 0) +
                ((resource.data.deletedForUids is list &&
                    resource.data.deletedForUids.hasAll([request.auth.uid]))
                  ? 0
                  : 1) &&
            request.resource.data.deletedForUids.hasAll(
              resource.data.deletedForUids is list ? resource.data.deletedForUids : []
            ) &&
            request.resource.data.deletedForUids.hasAll([request.auth.uid])
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'deletedForEveryone',
              'deletedByUid',
              'deletedAt'
            ]) &&
            resource.data.senderUid == request.auth.uid &&
            request.resource.data.deletedForEveryone == true &&
            request.resource.data.deletedByUid == request.auth.uid
          )
        );
        allow delete: if isAdmin();

        match /reactions/{reactorUid} {
          allow read: if isChatParticipant(chatId);
          allow create, update, delete:
            if isSelf(reactorUid) && isChatParticipant(chatId);
        }
      }

      match /polls/{pollId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId)
          && request.resource.data.createdByUid == request.auth.uid;
        allow update: if isChatParticipant(chatId)
          && resource.data.createdByUid == request.auth.uid;
        allow delete: if isChatParticipant(chatId)
          && resource.data.createdByUid == request.auth.uid;

        match /votes/{voterUid} {
          allow read: if isChatParticipant(chatId);
          allow create, update, delete:
            if isSelf(voterUid) && isChatParticipant(chatId);
        }
      }
    }

    match /notifications/{uid}/items/{itemId} {
      allow read: if isSelf(uid) || isAdmin();
      allow update: if isSelf(uid);
      allow delete: if isSelf(uid) || isAdmin() || resource.data.actorUid == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.actorUid == request.auth.uid;
    }

    match /liveStreams/{streamId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      allow update, delete: if signedIn() && (
        resource.data.hostUid == request.auth.uid || isAdmin()
      );
    }

    // ── Contact-us / support threads ──────────────────────────
    // Each doc is one back-and-forth conversation between a user and
    // the admin team. The user can create their own threads and read
    // only their own; admins can see and reply to everything. The
    // chat-style turns live in the `messages` subcollection.
    match /contactRequests/{requestId} {
      allow get: if signedIn() && (
        isAdmin() ||
        resource.data.userUid == request.auth.uid
      );
      // Admins can list everything. Regular users may list too, but
      // Firestore enforces that every doc returned must individually
      // pass the `get` rule above — so the client MUST filter by
      // userUid == auth.uid or the query will error. The service
      // wrapper does exactly that.
      allow list: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.type in ['message', 'organization'];
      // Either party can update the thread doc to flip unread flags /
      // bump lastMessageAt. Admins can additionally change status.
      allow update: if signedIn() && (
        isAdmin() ||
        resource.data.userUid == request.auth.uid
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn() && (
          isAdmin() ||
          get(/databases/$(database)/documents/contactRequests/$(requestId)).data.userUid == request.auth.uid
        );
        allow create: if signedIn() &&
          request.resource.data.senderUid == request.auth.uid && (
            isAdmin() ||
            get(/databases/$(database)/documents/contactRequests/$(requestId)).data.userUid == request.auth.uid
          );
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
