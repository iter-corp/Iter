rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isChatParticipant(chatId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // Public app-wide config (feature flags, announcements, maintenance).
    // Any signed-in user reads it; only admins write.
    match /adminConfig/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isSelf(uid);
      allow update: if isSelf(uid) || isAdmin();
      allow delete: if isSelf(uid) || isAdmin();

      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create, delete: if isSelf(followerUid);
        allow update: if false;
      }

      match /following/{followingUid} {
        allow read: if signedIn();
        allow create, delete: if isSelf(uid);
        allow update: if false;
      }

      match /reposts/{postId} {
        allow read: if signedIn();
        allow create, delete: if isSelf(uid);
        allow update: if false;
      }

      match /saved/{postId} {
        allow read: if isSelf(uid);
        allow create, delete: if isSelf(uid);
        allow update: if false;
      }

      match /savedTranslations/{translationId} {
        allow read, delete: if isSelf(uid);
        allow create: if isSelf(uid);
        allow update: if false;
      }
    }

    match /follows/{targetUid}/followers/{followerUid} {
      allow read: if signedIn();
      allow create, delete: if isSelf(followerUid);
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.authorUid == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount', 'likesCount'])
      );
      allow delete: if signedIn() && (
        resource.data.authorUid == request.auth.uid || isAdmin()
      );

      match /likes/{uid} {
        allow read: if true;
        allow create, delete: if isSelf(uid);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
        allow delete: if signedIn() && (
          resource.data.authorUid == request.auth.uid || isAdmin()
        );
        allow update: if false;
      }

      match /reposts/{uid} {
        allow read: if true;
        allow create, delete: if isSelf(uid);
        allow update: if false;
      }
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if signedIn() && (
        resource.data.authorUid == request.auth.uid || isAdmin()
      );

      match /viewers/{viewerUid} {
        allow read: if signedIn() && (
          isSelf(viewerUid) ||
          get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid == request.auth.uid ||
          isAdmin()
        );
        allow create: if isSelf(viewerUid);
        allow update, delete: if false;
      }
    }

    match /events/{eventId} {
      allow read: if true;
      // Admin-managed events — only admins may create/update/delete.
      allow create: if isAdmin();
      allow update, delete: if isAdmin();

      match /attendees/{uid} {
        allow read: if true;
        allow create, delete: if isSelf(uid);
      }
    }

<<<<<<< Updated upstream
