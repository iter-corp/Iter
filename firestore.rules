rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function canSeeContent(uid) {
      let user = get(/databases/$(database)/documents/users/$(uid)).data;
      return !user.isPrivate || isSelf(uid) || 
             (exists(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid)).data.status == 'active');
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Limited "events-only admin" role granted via the contact-us
    // organization flow. Lets these users create / edit / delete events
    // but nothing else (no user moderation, no app config, no reports
    // access). Always rule-or'd alongside isAdmin() at the event match.
    function isOrgAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'org_admin';
    }

    function canManageNewEventNotification() {
      return isOrgAdmin() &&
        resource.data.type == 'new_event' &&
        resource.data.targetId is string &&
        exists(/databases/$(database)/documents/events/$(resource.data.targetId)) &&
        get(/databases/$(database)/documents/events/$(resource.data.targetId)).data.createdByUid == request.auth.uid;
    }

    function isChatParticipant(chatId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // Public app-wide config (feature flags, announcements, maintenance).
    // Any signed-in user reads it; only admins write.
    match /adminConfig/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Crash / handled-error reports written by the in-app error handler.
    // Anyone (incl. not-yet-signed-in users hitting a boot crash) may create
    // a report, but the document is shape- and size-validated so the
    // open-create rule can't be abused to dump arbitrary data into Firestore.
    // Only admins may read them or mark them resolved / delete.
    function isValidErrorReport() {
      let d = request.resource.data;
      return d.keys().hasOnly([
              'message', 'stack', 'kind', 'context', 'screen',
              'uid', 'platform', 'appVersion', 'resolved', 'createdAt'
            ]) &&
            d.message is string && d.message.size() > 0 && d.message.size() <= 2000 &&
            d.stack is string && d.stack.size() <= 8000 &&
            d.kind is string && d.kind.size() <= 40 &&
            (!('context' in d) || (d.context is string && d.context.size() <= 1000)) &&
            (!('screen' in d) || (d.screen is string && d.screen.size() <= 200)) &&
            (!('uid' in d) || d.uid == null || (d.uid is string && d.uid.size() <= 128)) &&
            d.platform is string && d.platform.size() <= 40 &&
            d.appVersion is string && d.appVersion.size() <= 40 &&
            d.resolved == false &&
            d.createdAt == request.time;
    }
    match /errorReports/{reportId} {
      allow create: if isValidErrorReport();
      // Admins may only flip `resolved` (and we keep createdAt immutable).
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved']) &&
        request.resource.data.resolved is bool;
      allow read, delete: if isAdmin();
    }

    function isValidPostReport() {
      let d = request.resource.data;
      return d.keys().hasOnly([
              'postId', 'postAuthorUid', 'postAuthorUsername',
              'postAuthorAvatar', 'postCaption', 'reporterUid',
              'reporterUsername', 'reason', 'details', 'resolved',
              'createdAt', 'resolvedAt'
            ]) &&
            d.postId is string && d.postId.size() > 0 && d.postId.size() <= 150 &&
            d.postAuthorUid is string && d.postAuthorUid.size() > 0 && d.postAuthorUid.size() <= 128 &&
            d.postAuthorUsername is string && d.postAuthorUsername.size() > 0 && d.postAuthorUsername.size() <= 80 &&
            (!('postAuthorAvatar' in d) || d.postAuthorAvatar == null || (d.postAuthorAvatar is string && d.postAuthorAvatar.size() <= 1000)) &&
            d.postCaption is string && d.postCaption.size() <= 6000 &&
            d.reporterUid == request.auth.uid &&
            d.reporterUsername is string && d.reporterUsername.size() > 0 && d.reporterUsername.size() <= 80 &&
            d.reason is string && d.reason.size() > 0 && d.reason.size() <= 80 &&
            (!('details' in d) || d.details == null || (d.details is string && d.details.size() <= 2000)) &&
            d.resolved == false &&
            d.createdAt == request.time &&
            (!('resolvedAt' in d) || d.resolvedAt == null);
    }

              function isValidUserProfileReport() {
                let d = request.resource.data;
                return d.keys().hasOnly([
                  'targetUid', 'targetUsername', 'targetAvatar',
                  'reporterUid', 'reporterUsername',
                  'reason', 'details', 'resolved', 'createdAt', 'resolvedAt'
                ]) &&
                d.targetUid is string && d.targetUid.size() > 0 && d.targetUid.size() <= 128 &&
                d.targetUsername is string && d.targetUsername.size() > 0 && d.targetUsername.size() <= 80 &&
                (!('targetAvatar' in d) || d.targetAvatar == null || (d.targetAvatar is string && d.targetAvatar.size() <= 1000)) &&
                d.reporterUid == request.auth.uid &&
                d.reporterUsername is string && d.reporterUsername.size() > 0 && d.reporterUsername.size() <= 80 &&
                d.reason is string && d.reason.size() > 0 && d.reason.size() <= 80 &&
                (!('details' in d) || d.details == null || (d.details is string && d.details.size() <= 2000)) &&
                d.resolved == false &&
                d.createdAt == request.time &&
                (!('resolvedAt' in d) || d.resolvedAt == null);
              }

    match /postReports/{reportId} {
      allow create: if signedIn() && isValidPostReport();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedAt']) &&
        request.resource.data.resolved is bool;
      // Reporters may read their own report (the client's duplicate-report
      // pre-check does a get() before creating). Admins may read all.
      allow get: if isAdmin() ||
        (signedIn() &&
          (resource == null || resource.data.reporterUid == request.auth.uid));
      allow list, delete: if isAdmin();
    }

    match /discussReports/{reportId} {
      allow create: if signedIn() && isValidPostReport();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedAt']) &&
        request.resource.data.resolved is bool;
      allow get: if isAdmin() ||
        (signedIn() &&
          (resource == null || resource.data.reporterUid == request.auth.uid));
      allow list, delete: if isAdmin();
    }

    match /userReports/{reportId} {
      allow create: if signedIn() && isValidUserProfileReport();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedAt']) &&
        request.resource.data.resolved is bool;
      allow get: if isAdmin() ||
        (signedIn() &&
          (resource == null || resource.data.reporterUid == request.auth.uid));
      allow list, delete: if isAdmin();
    }

    // Blacklisted emails. Admins manage the full list; signed-in users may
    // also read and write their own entry so the client can (a) check on
    // login whether their account has been deleted and (b) write a
    // tombstone for themselves during self-delete.
    match /blacklist/{email} {
      allow read: if isAdmin() ||
        (signedIn() && request.auth.token.email == email);
      allow write: if isAdmin() ||
        (signedIn() && request.auth.token.email == email);
    }

    match /users/{uid} {
      allow read: if true;
      allow create: if isSelf(uid);
      allow update: if isSelf(uid) || isAdmin();
      allow delete: if isSelf(uid) || isAdmin();

      match /followers/{followerUid} {
        // Any signed-in user can read individual follower docs (needed for
        // the isFollowing check and follower counts on profiles). The data
        // only contains UIDs and timestamps — no sensitive info.
        allow read: if signedIn();
        allow create: if isSelf(followerUid) || isSelf(uid);
        allow delete: if isSelf(followerUid) || isSelf(uid) || isAdmin();
        allow update: if isSelf(uid);
      }

      match /following/{followingUid} {
        // The owner can always read their own following list. Other
        // signed-in users can read it for counts/list display on profiles.
        allow read: if signedIn();
        allow create: if isSelf(uid) || isSelf(followingUid);
        allow delete: if isSelf(uid) || isSelf(followingUid) || isAdmin();
        allow update: if isSelf(uid) || isSelf(followingUid);
      }

      match /blockedUsers/{blockedUid} {
        allow read: if signedIn();
        allow create, delete: if isSelf(uid) || isAdmin();
        allow update: if false;
      }

      match /reposts/{postId} {
        allow read: if signedIn();
        allow create: if isSelf(uid);
        allow delete: if isSelf(uid) || isAdmin();
        allow update: if false;
      }

      match /saved/{postId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid);
        allow delete: if isSelf(uid) || isAdmin();
        allow update: if false;
      }

      match /savedTranslations/{translationId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid);
        allow delete: if isSelf(uid) || isAdmin();
        allow update: if false;
      }

      // "Who viewed my profile" — one doc per visitor at
      // users/{uid}/visitors/{visitorUid}. Only the profile owner (or an
      // admin) can read the list. The visitor writes their own doc on
      // visit; the owner may delete entries to clear their list.
      match /visitors/{visitorUid} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, update: if isSelf(visitorUid) && visitorUid != uid;
        allow delete: if isSelf(uid) || isSelf(visitorUid) || isAdmin();
      }
    }

    // Collection-group access for admin cleanup (deleteUser cascade) and for
    // a user's own self-delete sweep. A user may read (to locate) their OWN
    // cross-user traces so account self-deletion can leave nothing behind,
    // even on the Spark/free plan (no Cloud Functions). The actual delete of
    // each trace is still governed by its per-collection delete rule, which
    // already permits the owner (isSelf / authorUid == auth.uid).
    match /{path=**}/followers/{followerUid} {
      allow read: if isAdmin() || isSelf(followerUid);
    }
    match /{path=**}/following/{followingUid} {
      allow read: if isAdmin() || isSelf(followingUid);
    }
    match /{path=**}/comments/{commentId} {
      // Per-post comment access goes through /posts/{postId}/comments below
      // (open to any signed-in user).
      //
      // The collection-group form is needed for the profile "Answers" tab —
      // it runs `collectionGroup('comments').where('authorUid', '==', uid)`.
      // We allow that for any signed-in user reading their OWN comments
      // (resource.data.authorUid == request.auth.uid), plus a blanket admin
      // read for moderation tools. Other users' comments remain reachable
      // only via the per-post path. Self-delete reuses this to find and
      // delete the user's own comments wherever they live.
      allow read: if isAdmin() ||
        (signedIn() && resource.data.authorUid == request.auth.uid);
    }
    // collectionGroup reads for a user's OWN likes / reposts / reactions so
    // the self-delete sweep can find and remove them from anywhere. For these
    // the document id IS the acting user's uid, so isSelf(...) scopes the read
    // strictly to the caller's own trace — never anyone else's.
    match /{path=**}/likes/{likeUid} {
      allow read: if isAdmin() || isSelf(likeUid);
    }
    match /{path=**}/reposts/{repostUid} {
      allow read: if isAdmin() || isSelf(repostUid);
    }
    match /{path=**}/reactions/{reactionUid} {
      allow read: if isAdmin() || isSelf(reactionUid);
    }

    match /follows/{targetUid}/followers/{followerUid} {
      allow read: if signedIn();
      allow create, delete: if isSelf(followerUid);
    }

    // Explicit top-level coverage for answer reactions under post comments.
    // Firestore doc snapshot listeners are evaluated as queries (`list`), so
    // keep `get` and `list` spelled out here for this exact path.
    match /posts/{postId}/comments/{commentId}/reactions/{uid} {
      allow get, list: if signedIn();
      allow create, update, delete: if isSelf(uid) || isAdmin();
    }

    match /posts/{postId} {
      // Any signed-in user can read posts. Privacy/blocking is enforced on
      // the client (the feed filters posts whose author is private and not
      // followed). The previous `canSeeContent` rule called get() on the
      // author's user doc, which made list queries fail entirely because
      // Firestore can't filter list results by rule — it can only reject
      // the whole query.
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      // A post (including a Q&A "question" post) may only be EDITED by
      // its author or an admin. Everyone else is limited to two
      // non-content tagging operations:
      //   - bumping commentsCount / likesCount,
      //   - setting discussTopicId once, when turning the post into a
      //     Discuss topic.
      // This keeps question/caption text author-only while still
      // letting any user link a post to its Discuss thread.
      allow update: if signedIn() && (
        resource.data.authorUid == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount', 'likesCount']) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['discussTopicId'])
      );
      allow delete: if signedIn() && (
        resource.data.authorUid == request.auth.uid || isAdmin()
      );

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if isSelf(uid);
        allow delete: if isSelf(uid) || isAdmin();
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
        allow delete: if signedIn() && (
          resource.data.authorUid == request.auth.uid || isAdmin()
        );
        // Two kinds of updates are allowed:
        //   1. Any signed-in user can bump reaction / like counters on
        //      the comment (helpfulCount / unhelpfulCount / likesCount).
        //   2. The comment's own author (or an admin) can edit the
        //      text. `affectedKeys().hasOnly([...])` already implies
        //      `authorUid` is untouched, so no need to also assert
        //      that it's unchanged — that extra check was causing
        //      legacy docs (with no `authorUid` initially missing) to
        //      fail the equality even though the field never moved.
        allow update: if signedIn() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'helpfulCount',
            'unhelpfulCount',
            'likesCount'
          ]) ||
          (
            (resource.data.authorUid == request.auth.uid || isAdmin()) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'text',
              'editedAt'
            ])
          )
        );

        match /likes/{uid} {
          allow read: if signedIn();
          allow create: if isSelf(uid);
          allow delete: if isSelf(uid) || isAdmin();
          allow update: if false;
        }

        match /reactions/{uid} {
          allow read: if signedIn();
          allow create, update, delete: if isSelf(uid) || isAdmin();
        }
      }

      match /privateComments/{uid} {
        allow read, write: if isSelf(uid) || isAdmin();

        match /items/{commentId} {
          allow read: if isSelf(uid) || isAdmin();
          allow create: if isSelf(uid) && request.resource.data.authorUid == request.auth.uid;
          // Owner can edit the text of their own sender-only comment
          // (e.g. fixing a word the profanity filter flagged). Only
          // `text` and `editedAt` may change; the rest of the doc
          // (authorUid, profanity flags, etc.) stays put.
          allow update: if isSelf(uid) &&
            resource.data.authorUid == request.auth.uid &&
            request.resource.data.authorUid == resource.data.authorUid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'text',
              'editedAt'
            ]);
          allow delete: if isSelf(uid) || isAdmin();
        }
      }

      match /reposts/{uid} {
        allow read: if signedIn();
        allow create: if isSelf(uid);
        allow delete: if isSelf(uid) || isAdmin();
        allow update: if false;
      }
    }

    match /stories/{storyId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.authorUid == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount', 'likesCount'])
      );
      allow delete: if signedIn() && (
        resource.data.authorUid == request.auth.uid || isAdmin()
      );

      match /likes/{uid} {
        allow read: if true;
        allow create: if isSelf(uid);
        allow delete: if isSelf(uid) || isAdmin();
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
        allow delete: if signedIn() && (
          resource.data.authorUid == request.auth.uid || isAdmin()
        );
        allow update: if false;

        match /likes/{uid} {
          allow read: if true;
          allow create: if isSelf(uid);
          allow delete: if isSelf(uid) || isAdmin();
          allow update: if false;
        }
      }

      match /viewers/{viewerUid} {
        allow read: if signedIn() && (
          isSelf(viewerUid) ||
          get(/databases/$(database)/documents/stories/$(storyId)).data.authorUid == request.auth.uid ||
          isAdmin()
        );
        allow create: if isSelf(viewerUid);
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /events/{eventId} {
      allow read: if true;
      // Full admins may create / edit / delete any event. Org-admins
      // (organizations approved via the contact-us flow) may create
      // their own and only edit / delete the ones THEY created.
      allow create: if isAdmin() || (
        isOrgAdmin() &&
        request.resource.data.createdByUid == request.auth.uid
      );
      allow update, delete: if isAdmin() || (
        isOrgAdmin() &&
        resource.data.createdByUid == request.auth.uid
      );

      match /attendees/{uid} {
        allow read: if true;
        allow create, delete: if isSelf(uid);
      }
    }

    // ── Event registration requests ─────────────────────────
    // Doc id is deterministic `{eventId}_{uid}` so a user can only have one
    // in-flight request per event and can read their own record.
    match /eventRegistrations/{regId} {
      // `get` must succeed even when the doc doesn't yet exist, so the
      // event-detail screen can render the "Register" button for a
      // user who has never registered for this event. We allow it
      // when the deterministic doc id ends with the user's uid — that
      // guarantees the user is only ever reading their own
      // (potentially missing) record.
      allow get: if signedIn() && (
        isAdmin() ||
        (resource != null &&
          resource.data.userUid == request.auth.uid) ||
        regId.matches('.*_' + request.auth.uid)
      );
      allow list: if isAdmin();
      allow create: if signedIn() &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      // Only admins can approve/reject; users may not EDIT a submitted
      // request. A user MAY delete their own registration — needed so
      // account self-delete removes the user's event sign-ups completely.
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (signedIn() && resource.data.userUid == request.auth.uid);
    }

    // ── Collection-group rule for members ────────────────────
    // Required to allow collectionGroup('members').where('uid', ...) queries
    // used to look up which event chats the current user belongs to.
    // Only the member themselves (or an admin) may read their own member doc
    // via the collection group.
    match /{path=**}/members/{uid} {
      allow read: if signedIn() && (isSelf(uid) || isAdmin());
    }

    // ── Event group chats (members read, admin writes) ──────
    match /eventChats/{eventId} {
      allow read: if signedIn() && (
        isAdmin() ||
        exists(/databases/$(database)/documents/eventChats/$(eventId)/members/$(request.auth.uid))
      );
      // Full admins manage every event chat; org-admins may create or
      // update only the chat for an event they themselves created
      // (write happens inline from AdminService.createEvent right
      // after the parent event doc is written).
      allow create, update: if isAdmin() || (
        isOrgAdmin() &&
        request.resource.data.adminUid == request.auth.uid
      );
      allow delete: if isAdmin();

      match /members/{uid} {
        // Any member of the chat (or admin) can read the members list so
        // they can see who else is in the group.
        allow read: if signedIn() && (
          isSelf(uid) ||
          isAdmin() ||
          exists(/databases/$(database)/documents/eventChats/$(eventId)/members/$(request.auth.uid))
        );
        // Members are added by the admin on approval; users can only remove
        // themselves (leave). Admin may also re-write the member doc when
        // adding a user directly (set with merge:true).
        allow create, update: if isAdmin();
        allow delete: if isSelf(uid) || isAdmin();
      }

      match /messages/{messageId} {
        allow read: if signedIn() && (
          isAdmin() ||
          exists(/databases/$(database)/documents/eventChats/$(eventId)/members/$(request.auth.uid))
        );
        // Only admins may send the message itself. Members may still react
        // on the subcollection below.
        allow create: if isAdmin() &&
          request.resource.data.senderUid == request.auth.uid;
        allow update: if false;
        allow delete: if isAdmin();

        match /reactions/{reactorUid} {
          allow read: if signedIn() && (
            isAdmin() ||
            exists(/databases/$(database)/documents/eventChats/$(eventId)/members/$(request.auth.uid))
          );
          allow create, update, delete: if isSelf(reactorUid) && (
            isAdmin() ||
            exists(/databases/$(database)/documents/eventChats/$(eventId)/members/$(request.auth.uid))
          );
        }
      }

      match /polls/{pollId} {
        allow read: if signedIn() && (
          isAdmin() ||
          exists(/databases/$(database)/documents/eventChats/$(eventId)/members/$(request.auth.uid))
        );
        // Only the event admin can create / close / delete polls.
        allow create: if isAdmin()
          && request.resource.data.createdByUid == request.auth.uid;
        allow update, delete: if isAdmin();

        match /votes/{voterUid} {
          allow read: if signedIn() && (
            isAdmin() ||
            exists(/databases/$(database)/documents/eventChats/$(eventId)/members/$(request.auth.uid))
          );
          allow create, update, delete: if isSelf(voterUid) && (
            isAdmin() ||
            exists(/databases/$(database)/documents/eventChats/$(eventId)/members/$(request.auth.uid))
          );
        }
      }
    }

    match /feeds/{uid}/timeline/{postId} {
      allow read: if isSelf(uid);
      allow write: if false;
    }

    match /chats/{chatId} {
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/chats/$(chatId)) ||
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow list: if signedIn() && (
        request.auth.uid in resource.data.participants ||
        isAdmin()
      );
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      // Any participant can update the chat doc (send a message bumps
      // lastMessage / unread counts). The group admin can also rename
      // or add/remove members through this same path.
      allow update: if signedIn() && (
        request.auth.uid in resource.data.participants ||
        request.auth.uid in request.resource.data.participants
      );
      // Admins, or any participant, may delete the chat doc. Participant
      // delete is needed so account self-delete removes the whole
      // conversation for BOTH sides. The client deletes all messages first,
      // then the chat doc.
      allow delete: if isAdmin() ||
        (signedIn() && request.auth.uid in resource.data.participants);

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId) || isAdmin();
        allow create: if isChatParticipant(chatId) && request.resource.data.senderUid == request.auth.uid;
        // Chat participants may mark messages seen, hide a message for
        // themselves, and the sender may delete a message for everyone.
        allow update: if isChatParticipant(chatId) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy']) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedForUids']) &&
            request.resource.data.deletedForUids is list &&
            request.resource.data.deletedForUids.size() ==
              (resource.data.deletedForUids is list ? resource.data.deletedForUids.size() : 0) +
                ((resource.data.deletedForUids is list &&
                    resource.data.deletedForUids.hasAll([request.auth.uid]))
                  ? 0
                  : 1) &&
            request.resource.data.deletedForUids.hasAll(
              resource.data.deletedForUids is list ? resource.data.deletedForUids : []
            ) &&
            request.resource.data.deletedForUids.hasAll([request.auth.uid])
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'deletedForEveryone',
              'deletedByUid',
              'deletedAt'
            ]) &&
            resource.data.senderUid == request.auth.uid &&
            request.resource.data.deletedForEveryone == true &&
            request.resource.data.deletedByUid == request.auth.uid
          )
        );
        // Admins, or any participant, may hard-delete a message. Participant
        // delete is needed for account self-delete to wipe the conversation
        // for both sides.
        allow delete: if isAdmin() || isChatParticipant(chatId);

        match /reactions/{reactorUid} {
          allow read: if isChatParticipant(chatId);
          allow create, update, delete:
            if isSelf(reactorUid) && isChatParticipant(chatId);
        }
      }

      match /polls/{pollId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId)
          && request.resource.data.createdByUid == request.auth.uid;
        allow update: if isChatParticipant(chatId)
          && resource.data.createdByUid == request.auth.uid;
        // The poll creator may delete it; any participant may also delete it
        // so account self-delete can fully clear a conversation's polls.
        allow delete: if isChatParticipant(chatId);

        match /votes/{voterUid} {
          allow read: if isChatParticipant(chatId);
          allow create, update, delete:
            if isSelf(voterUid) && isChatParticipant(chatId);
        }
      }
    }

    match /notifications/{uid}/items/{itemId} {
      allow get: if isSelf(uid) || isAdmin() ||
        (isOrgAdmin() && itemId.matches('new_event_.*'));
      allow list: if isSelf(uid) || isAdmin();
      allow update: if isSelf(uid);
      allow delete: if isSelf(uid) || isAdmin() || resource.data.actorUid == request.auth.uid || canManageNewEventNotification();
      // Normal notifications must name their author as the actor. Admins may
      // additionally fan out any system notification (actorUid == '') to any
      // user — used for new_event fan-out, role_update, and other admin-driven
      // system messages.
      allow create: if (signedIn() &&
          request.resource.data.actorUid == request.auth.uid)
        || (isAdmin() && request.resource.data.actorUid == '')
        || (isOrgAdmin() &&
            request.resource.data.actorUid == '' &&
            request.resource.data.type == 'new_event');
    }

    // ── Contact-us / support threads ──────────────────────────
    // Each doc is one back-and-forth conversation between a user and
    // the admin team. The user can create their own threads and read
    // only their own; admins can see and reply to everything. The
    // chat-style turns live in the `messages` subcollection.
    match /contactRequests/{requestId} {
      allow get: if signedIn() && (
        isAdmin() ||
        resource.data.userUid == request.auth.uid
      );
      // Admins can list everything. Regular users may list too, but
      // Firestore enforces that every doc returned must individually
      // pass the `get` rule above — so the client MUST filter by
      // userUid == auth.uid or the query will error. The service
      // wrapper does exactly that.
      allow list: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.type in ['message', 'organization'];
      // Either party can update the thread doc to flip unread flags /
      // bump lastMessageAt. Admins can additionally change status.
      allow update: if signedIn() && (
        isAdmin() ||
        resource.data.userUid == request.auth.uid
      );
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn() && (
          isAdmin() ||
          get(/databases/$(database)/documents/contactRequests/$(requestId)).data.userUid == request.auth.uid
        );
        allow create: if signedIn() &&
          request.resource.data.senderUid == request.auth.uid && (
            isAdmin() ||
            get(/databases/$(database)/documents/contactRequests/$(requestId)).data.userUid == request.auth.uid
          );
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
