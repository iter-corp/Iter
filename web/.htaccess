RewriteEngine On

# API & Backend proxy to Hono Node.js backend
RewriteRule ^api/(.*)$ api-proxy.php [QSA,L]
RewriteRule ^uploads/(.*)$ api-proxy.php [QSA,L]
RewriteRule ^health$ api-proxy.php [QSA,L]

# Allow assets/.env if requested by Flutter web
<Files ".env">
    Order allow,deny
    Allow from all
    Require all granted
</Files>

# SPA fallback for Flutter Web
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

AddType image/x-icon .ico
AddType image/png .png
