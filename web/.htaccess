RewriteEngine On

# API & Backend proxy to Hono Node.js backend
RewriteRule ^api/(.*)$ api-proxy.php [QSA,L]
RewriteRule ^uploads/(.*)$ api-proxy.php [QSA,L]
RewriteRule ^health$ api-proxy.php [QSA,L]

# Allow assets/.env if requested by Flutter web
<Files ".env">
    Order allow,deny
    Allow from all
    Require all granted
</Files>

# SPA fallback for Flutter Web
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# Prevent stale caching of app entrypoints and bundles
<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
</IfModule>

AddType image/x-icon .ico
AddType image/png .png
