{
  "name": "iter-backend-hono",
  "version": "1.0.0",
  "description": "Extensible, Server-Driven Hono Backend for Coil (Iter)",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node migrate-direct.cjs",
    "db:seed": "node seed-direct.cjs",
    "db:import-firebase": "tsx src/scripts/migrate-firebase-to-mysql.ts",
    "switch-env": "tsx src/scripts/switch-env.ts",
    "switch-domain": "tsx src/scripts/switch-env.ts",
    "media:sync": "node sync-media-to-remote.cjs",
    "test": "tsx test/api.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@hono/node-server": "^1.13.8",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-validator": "^0.4.3",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "firebase-admin": "^13.1.0",
    "hono": "^4.7.1",
    "jose": "^5.9.6",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.4",
    "postgres": "^3.4.5",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/ws": "^8.5.14",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
